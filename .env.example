# Copy to .env before building. `vite build` fails if any of these are missing,
# because Vite inlines them at build time and silently emits `undefined`
# otherwise, which ships a contact form that always errors.

# Google reCAPTCHA v3 site key (the public one, safe to expose in the bundle).
VITE_RECAPTCHA_SITE_KEY=

# EmailJS, from the dashboard. The public key is public by design; the form is
# protected by reCAPTCHA and EmailJS's own allowed-origins list, not by secrecy.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
